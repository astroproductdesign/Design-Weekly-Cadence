# Copy this file to .env.local and fill in the values (see README).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed for `npm run seed` (optional; the anon key also works).
SUPABASE_SERVICE_ROLE_KEY=

# Secure sign-in (see README, "Secure sign-in"). Leave these out to keep sign-in off.
# Server-only: never prefix with NEXT_PUBLIC_. Also used by the sign-in code routes.
# SUPABASE_SERVICE_ROLE_KEY (above) must be set in Vercel too.
NEXT_PUBLIC_REQUIRE_LOGIN=
# ALLOWED_EMAIL_DOMAIN=astro.com.my

# Our Calendar (see README, "Our Calendar"). Server-only: never prefix with NEXT_PUBLIC_.
# From the Notion connection's page; the leave calendar's id is the long code in its link.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_CALENDAR_ID=
